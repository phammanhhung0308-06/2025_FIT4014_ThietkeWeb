                <td style="background-color: #f2f2f2;"></td>
                <td style="background-color: #f2f2f2;"></td>
            </tr>
            <tr>
                <td style="font-weight: bold;">80549061</td>
                <td style="font-weight: bold;">John</td>
                <td>70%</td>
